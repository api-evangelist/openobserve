              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Exports the complete configuration of a specific alert in a format suitable for backup, sharing, or importing into other environments. Includes all alert settings, conditions, and notification configurations."
        },
        {
          "info": {
