        },
        {
          "info": {
            "name": "Preview diff between imported semantic groups and current DB state",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/:org_id/alerts/deduplication/semantic-groups/preview-diff",
