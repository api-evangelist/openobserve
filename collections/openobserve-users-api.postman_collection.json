          "name": "List organization users",
          "request": {
            "name": "List organization users",
            "description": {
              "content": "Retrieves a list of all users within the specified organization, including their roles, status, and basic profile information. Optionally filter to list users across all organizations if the requesting user has sufficient permissions. Returns user metadata such as email addresses, assigned roles, last login times, and account status.",
              "type": "text/plain"
            },
