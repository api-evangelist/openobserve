          "name": "Create new user",
          "request": {
            "name": "Create new user",
            "description": {
              "content": "Creates a new user account within the organization with specified role and authentication credentials. The password must be at least 8 characters long and the email address must be valid. Users are automatically assigned to the organization with the specified role and can begin accessing resources immediately upon creation.",
