{
  "opencollection": "1.0.0",
  "info": {
    "name": "openobserve Actions Report API",
    "version": "0.90.0"
  },
  "items": [
    {
      "info": {
        "name": "Report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Enable or disable dashboard report",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/:org_id/reports/:name/enable",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path",
                "description": "Organization name"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Report name"
              },
              {
                "name": "value",
                "value": "",
                "type": "query",
                "description": "Enable or disable report"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Enables or disables automated execution of a dashboard report. When disabled, scheduled report deliveries are paused but the configuration is preserved. When re-enabled, report deliveries resume according to the configured schedule. Useful for temporarily stopping report distribution without losing the complete report setup."
        }
      ]
    }
  ],
  "bundled": true
}