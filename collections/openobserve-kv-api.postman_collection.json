          "name": "List keys from key-value store",
          "request": {
            "name": "List keys from key-value store",
            "description": {
              "content": "Retrieves a list of all keys stored in the organization's key-value store. You can optionally filter keys by providing a prefix to only return keys that start with specific characters. This is useful for organizing related configuration settings or browsing available stored data.",
