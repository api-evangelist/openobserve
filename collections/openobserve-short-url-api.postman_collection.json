        {
          "id": "e9f010e5-1152-465b-9074-0baa45e46471",
          "name": "Resolve short URL",
          "request": {
            "name": "Resolve short URL",
            "description": {
              "content": "Resolves a shortened URL back to its original destination. By default, this endpoint redirects the user to the original URL. When the 'type=ui' query parameter is provided, it returns the original URL as JSON instead of performing a redirect. This is useful for applications that need to inspect or validate URLs before navigation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "short",
                ":org_id",
                "short",
                ":short_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Response type - if 'ui', returns JSON object instead of redirect"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "short_id",
                  "description": "(Required) The short ID to retrieve the original URL"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "org_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
